# Copy to .env and adjust. URLs point at a locally running PROMPT dev stack by default.

# PROMPT core
CORE_HOST=http://localhost:3000
SERVER_CORE_HOST=http://localhost:8080

# Keycloak (same instance the PROMPT core uses)
KEYCLOAK_HOST=http://localhost:8081
KEYCLOAK_REALM_NAME=prompt

# Phase database
DB_EXAMPLE_NAME=prompt
DB_EXAMPLE_USER=prompt-postgres
DB_EXAMPLE_PASSWORD=prompt-postgres

# Audit log (optional). Leave AUDIT_ENABLED empty to capture nothing. The ingest
# key must also be listed in AUDIT_INGEST_KEYS of the PROMPT core, under this
# service's reported name (example-service).
AUDIT_ENABLED=
AUDIT_INGEST_KEY_EXAMPLE_SERVER=

# Production only
# PHASE_HOST=phase.your-domain.org
# IMAGE_TAG=latest
# SENTRY_ENABLED=false
# SENTRY_DSN_EXAMPLE_SERVER=

DEBUG=false
